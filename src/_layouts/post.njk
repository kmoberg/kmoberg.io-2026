---
layout: base.njk
---
<article class="post">
  <header class="post-header">
    <div class="post-meta">
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      {% if tags %}{% for tag in tags %}{% if tag != 'posts' %}<span class="tag">{{ tag | upper }}</span>{% endif %}{% endfor %}{% endif %}
    </div>
    <h1>{{ title }}</h1>
  </header>
  <div class="post-body">
    {{ content | safe }}
  </div>
  <footer class="post-footer">
    <a href="/">&larr; All posts</a>
  </footer>
</article>
